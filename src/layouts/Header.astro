---
// Header.astro
import '../styles/globals.css';
import MobileMenu from './MobileMenu.svelte';
---

<header class="top-nav" aria-label="Navegación principal">

  <!-- Logo -->
  <a class="nav-logo" href="/" aria-label="ELIAC inicio">
    <img src="/LogoEliac.svg" alt="ELIAC logo" width="120" height="40" />
    <span class="logo-text">ELIAC</span>
  </a>

  <!-- Desktop nav (visible > 390px) -->
  <nav class="nav-desktop" aria-label="Primaria">
    <ul class="nav-links">
      <a class="nav-link" href="/Challenge">The Challenge</a>
      <a class="nav-link" href="/Resources">Resources</a>
      <a class="nav-link" href="/FAQs">FAQs</a>
        <a class="btn btn-light btn-lg" href="https://tally.so/r/mVrdGN">Get involved</a>
    
    </ul>
  </nav>

  <!-- Mobile overlay — Svelte gestiona la reactividad -->
   
  <!--MobileMenu client:load /-->

</header>

<style>
/* ── Top nav ─────────────────────────────────────── */
.top-nav {
  position: sticky;
  top: 0;
  z-index: 200;
  height: var(--nav-h);
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-inline: clamp(1.25rem, 4vw, 3rem);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Logo */
.nav-logo img {
  height: 2rem;
  width: auto;
  display: block;
}


/* Logo container */
.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
}

/* Logo image */
.nav-logo img {
  height: 2rem;
  width: auto;
  display: block;
}

/* Text next to logo */
.logo-text {
  font-size: 1.5rem; /* aprox tamaño h3 */
  font-weight: 700;
  color: var(--c-text);
  font-family: var(--ff-body);
}

/* ── Desktop links ───────────────────────────────── */
.nav-links {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-link {
  font-family: var(--ff-body);
  font-size: 1.125rem;
  font-weight: 500;
  color: var(--c-text);
  text-decoration: none;
  transition: color 0.2s;
}
.nav-link:hover { color: var(--c-accent); }

@media (max-width: 480px) {
  /*.nav-desktop { display: none; } */
}
</style>
