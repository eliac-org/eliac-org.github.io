---
// Prizes&Benefits.astro

const prizes = [
  {
    title: "Hands-on Learning:",
    text: "Work on real accelerator concepts beyond the classroom.",
  },
  {
    title: "Networking:",
    text: "Connect with students, mentors and professionals from labs and industry.",
  },
  {
    title: "Portfolio / CV:",
    text: "Showcase your work in front of experts — perfect for your CV, MSc/PhD or job applications.",
  },
  {
    title: "Recognition & prizes:",
    text: "Awards, visibility and potential collaboration opportunities. Prizes for the winners are still to be determined and will be announced in a near future.",
  },
];
---

<section class="prizes-section contenedor" aria-labelledby="prizes-title">

  <div class="prizes-section__left">
    <h2 class="prizes-section__title" id="prizes-title">Prizes & Benefits</h2>
    <ul class="prizes-section__list">
      {prizes.map((item) => (
        <li class="prizes-section__item">
          <span class="prizes-section__item-title">{item.title}</span>
          {" "}{item.text}
        </li>
      ))}
    </ul>
  </div>

</section>

<style>
  .prizes-section {
    display: grid;
    grid-template-columns: 1fr 464px;
    gap: var(--gap-desktop);
    align-items: start;
  }

  .prizes-section__title {
    margin-bottom: 2rem;
  }

  .prizes-section__list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0.85;
    line-height: 1.6;
    max-width: 625px;
  }

  .prizes-section__item-title {
    font-weight: 700;
  }

  .prizes-section__image {
    width: 100%;
    min-height: 424px;
    background: var(--c-secondary);
    border-radius: 12px;
  }

  @media (max-width: 1511px) {
    .prizes-section {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 390px) {
    .prizes-section {
      grid-template-columns: 1fr;
    }
    .prizes-section__image { min-height: 220px; }
    .prizes-section__list { max-width: 100%; }
  }
</style>
