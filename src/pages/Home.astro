---
// pages/Home.astro
import WhatIsIt from '../components/Home/WhatIsIt.astro';
import HowELIACWorks from '../components/Home/HowELIACWorks.astro';
import Purpose from '../components/Home/Goals&Purpose.astro';
import TheTeamBehindIt from '../components/Home/TheTeamBehindIt.astro';
import Prizes from '../components/Home/Prizes&Benefits.astro';
import Sponsors from '../components/Home/Sponsors&Partners.astro';
---

  <section class="hero" aria-labelledby="hero-title">
    <h1 class="hero__title" id="hero-title">
      Design the next generation of compact linear accelerators.
    </h1>
  </section>

  <div class="divider"></div>

  <WhatIsIt />

  <div class="divider"></div>

  <HowELIACWorks />

  <div class="divider"></div>

  <Purpose />

  <div class="divider"></div>

  <TheTeamBehindIt />

  <div class="divider"></div>

  <Prizes />

  <div class="divider"></div>

  <Sponsors />

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--nav-h) clamp(1.25rem, 6vw, 5rem) 4rem;
    position: relative;
    overflow: hidden;
    background: var(--c-secondary);
  }

  .hero__title {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 390px) {
    .hero__title { font-size: var(--fs-h1); }
  }
</style>
