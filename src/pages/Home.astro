---
// pages/Home.astro
import Layout from '../layouts/Layout.astro';
import WhatIsIt from './WhatIsIt.astro';
import HowItWorks from './HowELIACWork.astro';
import Purpose from './Goals&Purpose.astro';
---

  <section class="hero" aria-labelledby="hero-title">
    <h1 class="hero__title" id="hero-title">
      Design the next generation of compact linear accelerators.
    </h1>
  </section>

  <div class="divider"></div>

  <WhatIsIt />

  <div class="divider"></div>

  <HowItWorks />

  <div class="divider"></div>

  <Purpose />

</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--nav-h) clamp(1.25rem, 6vw, 5rem) 4rem;
    position: relative;
    overflow: hidden;
    background: var(--c-secondary);
  }

  .hero__title {
    font-family: var(--ff-display);
    font-size: var(--fs-h1);
    font-weight: 500;
    color: var(--c-text);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 390px) {
    .hero__title { font-size: var(--fs-h1); }
  }
</style>
