---
// Sponsors&Partners.astro
---

<section class="sponsors-section contenedor" aria-labelledby="sponsors-title">

  <h2 class="sponsors-section__title" id="sponsors-title">Sponsors & Partners</h2>

  <div class="sponsors-section__content">
    <p class="sponsors-section__body">
      Interested in sponsoring this event?<br/>
      Complete the form below or send an e-mail to
      <a class="sponsors-section__email" href="mailto:sponsoreliac2025@gmail.com">
        sponsoreliac2025@gmail.com
      </a>
    </p>
    <a class="cta" href="#">Partner with Us</a>
  </div>

</section>

<style>
  .sponsors-section__title {
    margin-bottom: 2rem;
  }

  .sponsors-section__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 625px;
  }

  .sponsors-section__body {
    opacity: 0.85;
    line-height: 1.6;
  }

  .sponsors-section__email {
    color: var(--c-primary);
    text-decoration: underline;
  }
  .sponsors-section__email:hover { color: var(--c-accent); }

  @media (max-width: 390px) {
    .sponsors-section__content { max-width: 100%; }
  }
</style>
