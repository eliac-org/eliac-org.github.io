---
// HowItWorks.astro

const steps = [
  {
    number: "1",
    title: "Form your team",
    text: "Look for other students and join forces to develop your technical purpose and a faculty advisor to take institutional responsibilities, then your team is ready to submit an application to the challenge.",
  },
  {
    number: "2",
    title: "Design your LINAC concept",
    text: "Review the ELIAC Handbook, specify your LINAC application, and distribute efforts across evaluation modules — focus on specific modules or propose a complete design.",
  },
  {
    number: "3",
    title: "Submit, pitch, compete",
    text: "Attend checkpoints and submit the required documentation. At the final event, try your best showing your design proposal; the prize is just around the corner.",
  },
];
---

<section class="how-section contenedor" aria-labelledby="how-title">
  <h2 class="how-section__title" id="how-title">How ELIAC works</h2>

  <div class="cards-grid">
    {steps.map((step) => (
      <article class="card">
        <span class="card__number">{step.number}</span>
        <h3 class="card__title">{step.title}</h3>
        <p class="card__text">{step.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .how-section {
    text-align: center;
  }

  .how-section__title {
    font-family: var(--ff-display);
    font-size: var(--fs-h2);
    font-weight: 500;
    color: var(--c-text);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 786px;
    margin-inline: auto;
    margin-bottom: 3rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 464px);
    justify-content: center;
    gap: var(--gap-desktop);
  }

  .card {
    background: var(--c-secondary);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    text-align: left;
    box-shadow: 0px 4px 4px 0px #00000040;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 424px; /* era height fijo — mantenemos como min-height */
  }

  .card__number {
    font-family: var(--ff-display);
    font-size: 3.5rem;
    font-weight: 500;
    color: var(--c-primary);
    line-height: 1;
    text-align: center;
  }

  .card__title {
    font-family: var(--ff-body);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--c-text);
    line-height: 1;
    text-align: center;
  }

  .card__text {
    font-family: var(--ff-body);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--c-text);
    line-height: 1.5;
    flex: 1;
    text-align: center;
  }

  @media (max-width: 1511px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .card { min-height: auto; }
  }

  @media (max-width: 390px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 350px;
      margin-inline: auto;
    }

    .card { min-height: 320px; }
  }
</style>
