---
// src/components/Challenge/Timeline.astro
const events = [
  { 
    date: "April 1st, 2026", 
    title: "ELIAC 26 Kick-off", 
    subtitle: "Registration Opening", 
    desc: "Complete with important information about this step of the competition"
  },  
  { 
    date: "November 13th, 2026", 
    title: "ELIAC 26 Registration Closure", 
    desc: "Complete with important information about this step of the competition",
    extraTitle: "ELIAC 27 Registration Opening", 
    extraDesc: "Complete with important information about this step..." 
  }, 
  { 
    date: "January 31st, 2027", 
    title: "ELIAC 27 Registration Closure", 
    desc: "Complete with important information about this step of the competition"
  },
  { 
    date: "March 1st, 2027", 
    title: "Preliminary Design Report", 
    desc: "Complete with important information..." 
  },
  { 
    date: "April 13th, 2027", 
    title: "Intermediate Review", 
    desc: "Complete with important information..." 
  }, 
  { 
    date: "May 31st, 2027", 
    title: "Final Documentation", 
    desc: "Complete with important information..." 
  },
  { 
    date: "July 20th-25th, 2027", 
    title: "Competition Event", 
    desc: "Complete with important information..." 
  }
];
---

<section class="timeline-section">
  <h2>Format & Phases</h2>
  <div class="timeline-container">
    <div class="main-line"></div>
    {events.map((event) => (
      <div class="timeline-item">
        <div class="date">{event.date}</div>
        <div class="dot"></div>
        <div class="content">
          <h3>{event.title}</h3>
          {event.subtitle && <span class="subtitle">{event.subtitle}</span>}
          <p>{event.desc}</p>
          {event.extraTitle && <div class="extra"><h3>{event.extraTitle}</h3><p>{event.desc}</p></div>}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline-section { padding: 4rem 2rem; color: white; max-width: 1000px; margin: auto; }
  .timeline-container { position: relative; padding-left: 150px; }
  
  /* La línea degradada */
  .main-line {
    position: absolute;
    left: 165px; top: 0; bottom: 0;
    width: 6px;
    background: linear-gradient(to bottom, #3b82f6, #2dd4bf, #84cc16, #eab308);
    border-radius: 10px;
  }

  .timeline-item { display: flex; align-items: flex-start; margin-bottom: 4rem; position: relative; }
  .date { width: 140px; text-align: right; margin-right: 40px; font-weight: 300; opacity: 0.8; }
  .dot { 
    width: 16px; height: 16px; background: white; border-radius: 50%; 
    position: absolute; left: 10px; top: 5px; z-index: 2;
    box-shadow: 0 0 10px rgba(255,255,255,0.5);
  }
  .content { flex: 1; }
  h3 { font-size: 1.5rem; margin: 0; }
  .subtitle { color: #aaa; font-size: 1.1rem; }
  p { opacity: 0.7; font-size: 0.9rem; margin-top: 0.5rem; }
</style>