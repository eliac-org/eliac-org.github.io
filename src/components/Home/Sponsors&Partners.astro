---
// Sponsors&Partners.astro
---

<section class="contenedor" aria-labelledby="sponsors-title">

  <h2 class="h2-margin" id="sponsors-title">Sponsors & Partners</h2>

  <div class="sponsors-content">
    <p class="text-muted">
      Interested in sponsoring this event?<br/>
      Complete the form below or send an e-mail to
      <a class="email-link" href="mailto:sponsoreliac2025@gmail.com">
        sponsoreliac2025@gmail.com
      </a>
    </p>
    
    <a class="btn btn-lg btn-slate " href="#">
  Partner with Us
</a>
  </div>

</section>

<style>
  .email-link {
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 700;
    color: var(--c-white);
    text-decoration: underline;
  }
  .email-link:hover { 
    color: var(--c-accent); 
  }
  .sponsors-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start; 
    gap: var(--gap);
    max-width: 65ch;
  }
  @media (max-width:390px){
    .sponsors-content .btn {
      align-self: center;
    }
  }
</style>